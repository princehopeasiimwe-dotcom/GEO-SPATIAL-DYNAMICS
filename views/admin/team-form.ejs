<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= member ? 'Edit' : 'New' %> Team Member — GDL Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/CSS/Style.CSS">
</head>
<body class="admin-body">
<div class="admin-wrap">
  <h1><%= member ? 'Edit Team Member' : 'New Team Member' %></h1>
  <form method="POST" action="/admin/team/save" enctype="multipart/form-data" class="settings-form">
    <% if (member) { %>
      <input type="hidden" name="id" value="<%= member.id %>">
      <% if (member.photo_path) { %>
        <label>Current photo</label>
        <img src="<%= member.photo_path %>" alt="" style="max-width:140px; border-radius:50%; display:block; margin-top:6px;">
      <% } %>
    <% } %>

    <label><%= member && member.photo_path ? 'Replace photo (optional)' : 'Photo (optional)' %></label>
    <input type="file" name="photo" accept="image/png, image/jpeg, image/webp">

    <label>Name</label>
    <input type="text" name="name" value="<%= member ? member.name : '' %>" required>

    <label>Role / Title</label>
    <input type="text" name="role" value="<%= member ? (member.role || '') : '' %>" placeholder="e.g. GIS Analyst">

    <label>Short bio (optional)</label>
    <textarea name="bio" rows="3"><%= member ? (member.bio || '') : '' %></textarea>

    <button type="submit" class="btn-primary">Save</button>
    <a href="/admin" class="btn-outline">Cancel</a>
  </form>
</div>
</body>
</html>