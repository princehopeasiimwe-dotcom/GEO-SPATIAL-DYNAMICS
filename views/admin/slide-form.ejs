<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= slide ? 'Edit' : 'New' %> Slide — GDL Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/CSS/Style.CSS">
</head>
<body class="admin-body">
<div class="admin-wrap">
  <h1><%= slide ? 'Edit Slide' : 'New Slide' %></h1>

  <form method="POST" action="/admin/slides/save" enctype="multipart/form-data" class="settings-form">
    <% if (slide) { %>
      <input type="hidden" name="id" value="<%= slide.id %>">
      <label>Current image</label>
      <img src="<%= slide.image_path %>" alt="" style="max-width:240px; display:block; margin-top:8px; border-radius:3px;">
    <% } %>

    <label><%= slide ? 'Replace image (optional)' : 'Image' %></label>
    <input type="file" name="image" accept="image/png, image/jpeg, image/webp" <%= slide ? '' : 'required' %>>

    <label>Eyebrow (small label above the heading, optional)</label>
    <input type="text" name="eyebrow" value="<%= slide ? (slide.eyebrow || '') : '' %>" placeholder="e.g. GIS · Remote Sensing · M&E">

    <label>Title (main heading shown over the image)</label>
    <input type="text" name="caption" value="<%= slide ? (slide.caption || '') : '' %>" placeholder="e.g. Field-grade geospatial data, delivered right.">

    <label>Subtitle (short supporting line, optional)</label>
    <textarea name="subtitle" rows="2"><%= slide ? (slide.subtitle || '') : '' %></textarea>

    <button type="submit" class="btn-primary">Save</button>
    <a href="/admin" class="btn-outline">Cancel</a>
  </form>
</div>
</body>
</html>