<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= service ? 'Edit' : 'New' %> Service — GDL Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
<div class="admin-wrap">
  <h1><%= service ? 'Edit Service' : 'New Service' %></h1>
  <form method="POST" action="/admin/services/save" enctype="multipart/form-data" class="settings-form">
    <% if (service) { %>
      <input type="hidden" name="id" value="<%= service.id %>">
    <% } %>

    <% if (service && service.image_path) { %>
      <label>Current image</label>
      <img src="<%= service.image_path %>" alt="" style="max-width:200px; display:block; margin-top:6px; border-radius:3px;">
    <% } %>
    <label><%= service && service.image_path ? 'Replace image (optional)' : 'Image (optional)' %></label>
    <input type="file" name="image" accept="image/png, image/jpeg, image/webp">

    <label>Title</label>
    <input type="text" name="title" value="<%= service ? service.title : '' %>" required>

    <label>Slug (used in the URL, e.g. gis-remote-sensing)</label>
    <input type="text" name="slug" value="<%= service ? service.slug : '' %>" required>

    <label>Summary</label>
    <textarea name="summary" rows="2"><%= service ? service.summary : '' %></textarea>

    <label>Features (one per line)</label>
    <textarea name="features_raw" rows="8"><%= featuresText %></textarea>

    <button type="submit" class="btn-primary">Save</button>
    <a href="/admin" class="btn-outline">Cancel</a>
  </form>
</div>
</body>
</html>