<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= industry ? 'Edit' : 'New' %> Industry — GDL Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
<div class="admin-wrap">
  <h1><%= industry ? 'Edit Industry' : 'New Industry' %></h1>
  <form method="POST" action="/admin/industries/save" enctype="multipart/form-data" class="settings-form">
    <% if (industry) { %>
      <input type="hidden" name="id" value="<%= industry.id %>">
      <% if (industry.image_path) { %>
        <label>Current image</label>
        <img src="<%= industry.image_path %>" alt="" style="max-width:200px; display:block; margin-top:6px; border-radius:3px;">
      <% } %>
    <% } %>

    <label><%= industry && industry.image_path ? 'Replace image (optional)' : 'Image (optional)' %></label>
    <input type="file" name="image" accept="image/png, image/jpeg, image/webp">

    <label>Icon (an emoji, e.g. 🌲)</label>
    <input type="text" name="icon" value="<%= industry ? (industry.icon || '') : '' %>">

    <label>Title</label>
    <input type="text" name="title" value="<%= industry ? industry.title : '' %>" required>

    <label>Description</label>
    <textarea name="description" rows="3"><%= industry ? (industry.description || '') : '' %></textarea>

    <button type="submit" class="btn-primary">Save</button>
    <a href="/admin" class="btn-outline">Cancel</a>
  </form>
</div>
</body>
</html>