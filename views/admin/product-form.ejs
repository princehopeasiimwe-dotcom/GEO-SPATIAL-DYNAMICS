<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= product ? 'Edit' : 'New' %> Product — GDL Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-body">
<div class="admin-wrap">
  <h1><%= product ? 'Edit Product' : 'New Product' %></h1>
  <form method="POST" action="/admin/products/save" enctype="multipart/form-data" class="settings-form">
    <% if (product) { %>
      <input type="hidden" name="id" value="<%= product.id %>">
      <% if (product.image_path) { %>
        <label>Current image</label>
        <img src="<%= product.image_path %>" alt="" style="max-width:200px; display:block; margin-top:6px; border-radius:3px;">
      <% } %>
    <% } %>

    <label><%= product && product.image_path ? 'Replace image (optional)' : 'Image (optional)' %></label>
    <input type="file" name="image" accept="image/png, image/jpeg, image/webp">

    <label>Name</label>
    <input type="text" name="name" value="<%= product ? product.name : '' %>" required>

    <label>Description</label>
    <textarea name="description" rows="3"><%= product ? (product.description || '') : '' %></textarea>

    <label>Price info (optional - e.g. "Contact for pricing", "$50/day hire")</label>
    <input type="text" name="price_info" value="<%= product ? (product.price_info || '') : '' %>">

    <button type="submit" class="btn-primary">Save</button>
    <a href="/admin" class="btn-outline">Cancel</a>
  </form>
</div>
</body>
</html>