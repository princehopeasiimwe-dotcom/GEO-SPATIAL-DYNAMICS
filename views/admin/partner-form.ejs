<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title><%= partner ? 'Edit' : 'New' %> Partner — GDL Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/CSS/Style.CSS">
</head>
<body class="admin-body">
<div class="admin-wrap">
  <h1><%= partner ? 'Edit Partner' : 'New Partner' %></h1>
  <form method="POST" action="/admin/partners/save" enctype="multipart/form-data" class="settings-form">
    <% if (partner) { %>
      <input type="hidden" name="id" value="<%= partner.id %>">
      <% if (partner.logo_path) { %>
        <label>Current logo</label>
        <img src="<%= partner.logo_path %>" alt="" style="max-width:160px; max-height:80px; display:block; margin-top:6px; background:#fff; padding:8px; border-radius:4px;">
      <% } %>
    <% } %>

    <label><%= partner && partner.logo_path ? 'Replace logo (optional)' : 'Logo (optional - shows the name as text until uploaded)' %></label>
    <input type="file" name="logo" accept="image/png, image/jpeg, image/webp">

    <label>Name</label>
    <input type="text" name="name" value="<%= partner ? partner.name : '' %>" required>

    <label>Website (optional)</label>
    <input type="text" name="website_url" value="<%= partner ? (partner.website_url || '') : '' %>" placeholder="https://...">

    <button type="submit" class="btn-primary">Save</button>
    <a href="/admin" class="btn-outline">Cancel</a>
  </form>
</div>
</body>
</html>